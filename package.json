{
  "name": "celsius-360-lite",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra": "docker compose up -d timescaledb clickhouse",
    "lint": "biome check .",
    "lint:ui": "bun run scripts/lint-ui.ts",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test ./packages ./apps/web/src",
    "test:integration": "bun test --timeout 120000 ./apps/ingest/test ./apps/api/test",
    "test:e2e": "bun run --cwd apps/web e2e",
    "migrate": "bun run --cwd apps/ingest src/main.ts migrate",
    "setup": "bun run --cwd apps/ingest src/main.ts setup",
    "seed": "bun run --cwd apps/ingest src/main.ts seed",
    "weather": "bun run --cwd apps/ingest src/main.ts weather",
    "replay": "bun run --cwd apps/ingest src/main.ts replay",
    "quality": "bun run --cwd apps/ingest src/main.ts quality",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "openapi": "bun run --cwd apps/api openapi",
    "fixture": "bun run scripts/gerar-fixture.ts",
    "e2e:install": "bun run --cwd apps/web playwright install chromium",
    "e2e:stack": "bun run scripts/e2e-stack.ts",
    "e2e:down": "bun run scripts/e2e-stack.ts down"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
